{
  "name": "@mg-mart/server",
  "version": "1.0.0",
  "description": "Express server for MG Mart",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "start:staging": "NODE_ENV=staging node dist/server.js",
    "deploy:build": "pnpm run build",
    "deploy:start": "pnpm run start:prod",
    "render:build": "pnpm install --frozen-lockfile && pnpm run build",
    "render:start": "pnpm run start:prod",
    "type-check": "tsc --noEmit",
    "lint": "echo 'Lint not configured yet'",
    "test-repos": "tsx src/test-repositories.ts",
    "test-controllers": "tsx src/test-controllers.ts",
    "test-endpoints": "tsx src/test-endpoints.ts",
    "validate-controllers": "tsx src/validate-controllers.ts",
    "test-runner": "tsx src/run-controller-tests.ts",
    "test-all": "tsx src/run-controller-tests.ts all",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@mg-mart/types": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "dotenv": "^17.2.2",
    "firebase-admin": "^13.5.0",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2"
  }
}